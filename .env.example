# ── Card Tracker Pro — Environment Variables ──────────────────────────────────
# Copy this file to .env.local for local development.
# In production (Vercel), add these in your project's Environment Variables settings.

# ── PriceCharting API ─────────────────────────────────────────────────────────
# Free API key from https://www.pricecharting.com/api
# Without this, PriceCharting scraping still works but is rate-limited.
PRICECHARTING_API_KEY=

# ── eBay Developer API ────────────────────────────────────────────────────────
# Get credentials at https://developer.ebay.com/
# Used for Finding API (sold listings) — returns real-time market data.
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_OAUTH_TOKEN=

# ── Vercel Cron Security ──────────────────────────────────────────────────────
# A secret string you choose — sent as Authorization header by Vercel Cron.
# Prevents external callers from triggering your cron endpoint.
CRON_SECRET=

# ── Database (optional — for persisting scraped data) ─────────────────────────
# Prisma schema is pre-configured for PostgreSQL.
# Free options: Neon (neon.tech), Supabase, Railway.
# DATABASE_URL=******host:5432/cardtracker
