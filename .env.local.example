# Card Tracker Pro - Environment Variables

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/card_tracker"

# Scraper API Keys & Configuration
# ===== REQUIRED KEYS =====
PRICECHARTING_API_KEY="get_free_key_at_pricecharting.com/api"
CRON_SECRET="openssl_rand_-hex_32_or_any_random_string"

# ===== OPTIONAL API KEYS (for future API integrations) =====
EBAY_API_KEY="your_ebay_api_key"
HERITAGE_AUCTIONS_API_KEY="optional_for_heritage"
GOLDIN_API_KEY="optional_for_goldin"
PWCC_API_KEY="optional_for_pwcc"
FANATICS_API_KEY="optional_for_fanatics"

# Scraper Job Configuration
SCRAPER_INTERVAL_MINUTES=30
SCRAPER_TIMEOUT_SECONDS=300
SCRAPER_MAX_RETRIES=3

# Data Management
DATA_RETENTION_DAYS=90
DUPLICATE_DETECTION_ENABLED=true

# Puppeteer/Browser Configuration
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=false
BROWSER_TIMEOUT_MS=30000

# Logging & Debugging
LOG_LEVEL=info
ENABLE_SCRAPER_LOGS=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_ENABLED=true

# Node Environment
NODE_ENV=production
